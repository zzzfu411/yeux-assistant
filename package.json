{
  "name": "yeux-assitant",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch apps/api/src/main.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "worker": "tsx apps/worker/src/main.ts",
    "typecheck": "tsc --noEmit && tsc -p apps/web/tsconfig.json",
    "build": "tsc && vite build --config apps/web/vite.config.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "verify": "node scripts/verify.mjs",
    "db:migrate": "tsx scripts/migrate.ts",
    "legacy:import": "tsx scripts/import-legacy.ts",
    "courses:import": "tsx scripts/import-courses.ts",
    "start": "node scripts/control.mjs start",
    "stop": "node scripts/control.mjs stop",
    "status": "node scripts/control.mjs status",
    "backup": "node scripts/control.mjs backup",
    "backup:check": "node scripts/backup-check.mjs",
    "doctor": "node scripts/doctor.mjs",
    "verify:e2e": "node scripts/verify-real.mjs",
    "admin:setup": "tsx scripts/setup-admin.ts",
    "quality": "node scripts/evaluate-learning.mjs",
    "tunnel": "node scripts/tunnel.mjs",
    "server": "node scripts/server-control.mjs",
    "server:probe": "node scripts/server-probe.mjs",
    "server:pack": "node scripts/server-pack.mjs",
    "verify:server": "node scripts/verify-server.mjs",
    "check:architecture": "node scripts/check-architecture.mjs",
    "agent:check": "node scripts/agent-check.mjs",
    "device:run": "tsx scripts/device-bridge.ts",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx}\" \"packages/**/*.ts\" \"scripts/**/*.{ts,mjs}\" \"tests/**/*.ts\"",
    "format": "prettier --write \"apps/**/*.{ts,tsx}\" \"packages/**/*.ts\" \"scripts/**/*.{ts,mjs}\" \"tests/**/*.ts\"",
    "workspace:import-rules": "tsx scripts/workspace-import-rules.ts",
    "ehall:simulate": "tsx scripts/ehall-simulator.ts",
    "research:eval": "node --import tsx scripts/evaluate-research.ts"
  },
  "dependencies": {
    "@fastify/static": "^8.3.0",
    "@langchain/core": "^1.1.0",
    "@langchain/langgraph": "^1.2.0",
    "@langchain/langgraph-checkpoint-postgres": "^1.0.0",
    "@modelcontextprotocol/sdk": "1.32.0",
    "@tanstack/react-query": "^5.90.0",
    "drizzle-orm": "^0.45.0",
    "fastify": "^5.6.0",
    "fastify-type-provider-zod": "^6.0.0",
    "imapflow": "^1.0.195",
    "mailparser": "^3.7.5",
    "nodemailer": "^7.0.0",
    "pg": "^8.16.0",
    "pg-boss": "^12.0.0",
    "playwright": "1.63.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "web-push": "3.6.7",
    "yaml": "2.9.1",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^7.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/web-push": "3.6.4",
    "@vitejs/plugin-react": "^5.1.0",
    "prettier": "3.9.9",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0",
    "vitest": "^4.0.0"
  },
  "description": "生成式软件工程 Lab1 / Lab2：个人数字助手与深入研究"
}
